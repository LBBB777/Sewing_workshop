: middle; white-space-collapse: preserve; tab-size: 4; color: rgba(0, 0, 0, 0.7); border-color: rgba(0, 0, 0, 0.05); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; border-radius: 8px; background-color: rgb(252, 252, 252); letter-spacing: 0.208px;&quot;&gt;alt&lt;/code&gt;&lt;span style=&quot;letter-spacing: 0.208px;&quot;&gt;&amp;nbsp;в HTML-код:&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
